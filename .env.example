# PostgreSQL connection string, e.g.
# postgresql://postgres:password@127.0.0.1:5432/app_db
#
# On Vercel: create a Postgres/Neon database and paste its pooled connection
# string into Project Settings → Environment Variables. Tables are created
# automatically on the first API request.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
